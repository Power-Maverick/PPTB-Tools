{
    "name": "@power-maverick/tool-copilot-studio-cost-analyzer",
    "version": "0.1.2",
    "displayName": "Copilot Studio Cost & Usage Analyzer",
    "description": "Analyze Copilot Studio agent credit consumption, capacity reports, and related Azure costs.",
    "icon": "icons/copilotStudioCostAnalyzer.svg",
    "main": "index.html",
    "license": "MIT",
    "contributors": [
        {
            "name": "Power Maverick",
            "url": "https://github.com/Power-Maverick"
        }
    ],
    "configurations": {
        "repository": "https://github.com/Power-Maverick/PPTB-Tools/tree/main/tools/copilot-studio-cost-analyzer",
        "readmeUrl": "https://raw.githubusercontent.com/Power-Maverick/PPTB-Tools/refs/heads/main/tools/copilot-studio-cost-analyzer/README.md"
    },
    "features": {
        "connections": 1,
        "minAPI": "1.2.9",
        "apis": {
            "pp": {
                "required": true
            },
            "arm": {
                "required": true
            }
        }
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "build": "npm run typecheck && vite build && npm run build:headless",
        "build:headless": "tsc -p tsconfig.headless.json",
        "dev": "vite",
        "watch": "vite build --watch",
        "dev-watch": "vite build --mode development --watch",
        "preview": "vite preview",
        "build:playground": "tsc && vite build --mode playground",
        "playground": "npm run build:playground && vite preview --outDir playground --host 127.0.0.1 --open /",
        "validate": "pptb-validate",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "version-stable": "npm version patch --no-git-tag-version",
        "publish-package": "npm run build && npm run version-stable && npm publish --access public"
    },
    "dependencies": {
        "@fluentui/react-components": "^9.72.7",
        "@fluentui/react-icons": "^2.0.314",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@pptb/types": "^1.2.9-beta.1",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.4",
        "typescript": "^5.6.3",
        "vite": "^7.1.11",
        "vitest": "^4.1.12"
    },
    "files": [
        "dist",
        "pptb.config.json"
    ]
}
