{
    "name": "@power-maverick/tool-root-cause-analyzer",
    "displayName": "Root Cause Analyzer",
    "version": "2.0.0",
    "description": "Trace every plugin, flow and change that touched a record — and pinpoint why it's wrong.",
    "icon": "icons/rootCauseAnalyzer.svg",
    "contributors": [
        {
            "name": "Power Maverick",
            "url": "https://github.com/Power-Maverick"
        }
    ],
    "license": "GPL-2.0",
    "configurations": {
        "repository": "https://github.com/Power-Maverick/PPTB-Tools/tree/main/tools/root-cause-analyzer",
        "readmeUrl": "https://raw.githubusercontent.com/Power-Maverick/PPTB-Tools/refs/heads/main/tools/root-cause-analyzer/README.md"
    },
    "features": {
        "connections": 1,
        "minAPI": "1.2.7",
        "enabledForPowerPlatformAPI": true
    },
    "type": "module",
    "scripts": {
        "build": "npm run typecheck && vite build && npm run build:headless",
        "build:headless": "tsc -p tsconfig.headless.json && mv dist/headless/headless.js dist/headless/headless.cjs && printf '{\"type\":\"commonjs\"}' > dist/headless/package.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "validate": "pptb-validate",
        "dev": "vite",
        "preview": "vite preview",
        "finalize-package": "npm shrinkwrap",
        "version-stable": "npm version patch --no-git-tag-version",
        "publish-package": "npm run build && npm publish --access public"
    },
    "files": [
        "dist",
        "npm-shrinkwrap.json"
    ],
    "keywords": [
        "dataverse",
        "plugin",
        "flow",
        "audit",
        "root-cause",
        "diagnostics",
        "power-platform",
        "pptb",
        "toolbox"
    ],
    "author": "Power Maverick",
    "dependencies": {
        "@fluentui/react-components": "^9.56.2",
        "@fluentui/react-icons": "^2.0.264",
        "@xyflow/react": "^12.12.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@pptb/types": "1.2.7",
        "@types/node": "^22.10.0",
        "@types/react": "^18.3.1",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.4",
        "typescript": "^5.9.3",
        "vite": "^6.0.7",
        "vitest": "^3.2.4"
    },
    "allowScripts": {
        "esbuild@0.25.12": true,
        "fsevents@2.3.3": true
    }
}
